+void Preprocess::na70_handler(const sensor_msgs::msg::PointCloud2::UniquePtr &msg)
+{
+  pl_surf.clear();
+  pl_corn.clear();
+  pl_full.clear();
+
+  pcl::PointCloud<na70_ros::Point> pl_orig;
+  pcl::fromROSMsg(*msg, pl_orig);
+  int plsize = pl_orig.points.size();
+  if (plsize == 0)
+    return;
+  pl_surf.reserve(plsize);
+
+  for (int i = 0; i < plsize; i++)
+  {
+    if (i % point_filter_num != 0)
+      continue;
+    const auto &p = pl_orig.points[i];
+    if (!std::isfinite(p.x) || !std::isfinite(p.y) || !std::isfinite(p.z))
+      continue;
+    double range2 = p.x * p.x + p.y * p.y + p.z * p.z;
+    if (range2 < blind * blind)
+      continue;
+    PointType added_pt;
+    added_pt.normal_x = 0;
+    added_pt.normal_y = 0;
+    added_pt.normal_z = 0;
+    added_pt.x = p.x;
+    added_pt.y = p.y;
+    added_pt.z = p.z;
+    added_pt.intensity = p.intensity;
+    // NA70 package stores per-point time in seconds; FAST-LIO curvature is ms.
+    added_pt.curvature = p.time * time_unit_scale;
+    pl_surf.points.push_back(added_pt);
+  }
+}
+
 void Preprocess::default_handler(const sensor_msgs::msg::PointCloud2::UniquePtr &msg)
 {
   pl_surf.clear();
